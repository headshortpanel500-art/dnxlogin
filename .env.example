# MongoDB connection string. Atlas free tier is enough for this scale.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dnxlogin

# Admin panel credentials. Change both before deploying.
ADMIN_USERNAME=dynamicx
ADMIN_PASSWORD=dynamicxtopx

# Signs the admin and reseller session cookies (HMAC-SHA256).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this value logs every admin and reseller out. It is NOT the same as
# ADMIN_PASSWORD -- if you leave it unset, ADMIN_PASSWORD is used as the key and
# changing the admin password invalidates all sessions.
SESSION_SECRET=
